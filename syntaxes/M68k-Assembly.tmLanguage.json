    "directive-section": {
      "name": "keyword.control.section.m68k",
      "match": "(?i)(?<=\\s)(section|pushsection|popsection|bss(_[cf])?|cseg|code(_[cf])?|data(_[cf])?|dseg|text)\\b"
    },
    "directive-condition": {
      "name": "keyword.control.condition.m68k",
      "match": "(?i)(?<=\\s)(if(eq|ne|gt|ge|lt|le|b|nb|c|nc|d|nd|1|2|p1|macrod|macrond)?|iif|elseif|else|endc|endif)\\b"
    },
    "directive-macro": {
      "name": "keyword.control.macro.m68k",
      "match": "(?i)(?<=\\s)(macro|endm|mexit)\\b"
    },
    "directive-assignment": {
      "name": "keyword.operator.assignment.m68k",
      "match": "(?i)(\\b(equ|fequ|set|equr|reg)\\b(\\.[sdxp])?|=(\\.[sdxp])?)"
    },
    "directive-other": {
      "name": "keyword.control.other.m68k",
      "match": "(?i)(?<=\\s)(opt|align|assert|basereg|cargs|clrfo|clrso|cnop|comm|comment|echo|einline|end[bfpr]?|erem|even|fail|far|fpu|idnt|inline|irp|irpc|jumpptr|list|llen|load|local|machine|mmu|msource|near|nolist|nopage|nref|odd|offset|opword|org|output|page|plen|print[tv]|public|record|rem|rept|rorg|rseven|rsreset|rsset|setfo|setso|spc|ttl|weak|xdef|xref)\\b"
    },
    "macro-call": {
      "name": "entity.name.function.macro.m68k",
      "match": "(?<![\\w.])[A-Za-z_][\\w.]*"
    },
    "operands": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#comment-asterisk-trailing"
        },
        {
          "include": "#strings"
        },
        {
          "name": "keyword.operator.immediate.m68k",
          "match": "#"
        },
        {
          "include": "#numbers"
        },
        {
          "name": "variable.language.pc.m68k",
          "match": "(?<![\\w.)\\]'\"])\\*"
        },
        {
          "include": "#registers"
        },
        {
          "include": "#builtin-symbols"
        },
        {
          "name": "variable.parameter.macro.m68k",
          "match": "\\\\(?:[0-9@#?.]|<[^>]*>|[A-Za-z_]\\w*)"
        },
        {
          "name": "support.type.size.m68k",
          "match": "(?<=[\\w)])\\.(?i:[bwlsdxpq])\\b"
        },
        {
          "name": "variable.other.m68k",
          "match": "[A-Za-z_.](?:[\\w.$]|\\\\@)*"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "registers": {
      "name": "variable.language.m68k",
      "match": "(?i)(?<![\\w.])([ad][0-7]|sp|ssp|usp|msp|isp|pc|zpc|sr|ccr|vbr|sfc|dfc|cacr|caar|fp[0-7]|fpcr|fpsr|fpiar)\\b"
    },
    "builtin-symbols": {
      "name": "variable.language.builtin.m68k",
      "match": "(?i)(?<![\\w.])(__rs|__so|__fo|narg|carg)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.m68k",
          "match": "(?<![\\w.$])\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.octal.m68k",
          "match": "(?<![\\w.$])@[0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.m68k",
          "match": "(?<![\\w.$])%[01]+\\b"
        },
        {
          "name": "entity.name.label.local.m68k",
          "match": "(?<![\\w.$])[0-9]+\\$"
        },
        {
          "name": "constant.numeric.decimal.m68k",
          "match": "(?<![\\w.$@%])[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?(?![\\w$])"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.arithmetic.m68k",
      "match": "<<|>>|&&|\\|\\||<=|>=|==|!=|<>|[-+*/&|!~^%<>=]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.m68k",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.m68k",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.m68k",
          "match": "[\\[\\]{}]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#string-double"
        },
        {
          "include": "#string-single"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.m68k",
      "match": "\"[^\"]*\""
    },
    "string-single": {
      "name": "string.quoted.single.m68k",
      "match": "'[^']*'"
    },
    "comments": {
      "patterns": [
        {
          "include": "#comment-documentation"
        },
        {
          "include": "#comment-semicolon"
        }
      ]
    },
    "comment-documentation": {
      "name": "comment.block.documentation",
      "match": ";\\*.*$"
    },
    "comment-semicolon": {
      "name": "comment.line.semicolon",
      "match": ";.*$"
    },
    "comment-asterisk-line": {
      "name": "comment.block.asterisk",
      "match": "^[ \\t]*\\*.*$"
    },
    "comment-asterisk-trailing": {
      "name": "comment.line.asterisk.m68k",
      "match": "(?<=[ \\t])\\*(?=[ \\t]).*$"
    }
  }
}
