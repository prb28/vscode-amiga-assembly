// Launch configurations for developing and debugging the Amiga Assembly extension
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "sourceMaps": true,
            "preLaunchTask": "npm: webpack",
            "env": {
                "DISABLE_COVERAGE": "true"
            }
        },
        {
            "name": "Launch Extension (Example Workspace)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-workspace-trust",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/resources/examples/vscode-amiga-wks-example"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "sourceMaps": true,
            "preLaunchTask": "npm: webpack",
            "env": {
                "DISABLE_COVERAGE": "true"
            }
        },
        {
            "name": "Launch Extension (No Build / Fast)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-workspace-trust",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/resources/examples/vscode-amiga-wks-example"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "sourceMaps": true,
            "env": {
                "DISABLE_COVERAGE": "true"
            }
        },
        {
            "name": "Extension Tests",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionTestsPath=${workspaceFolder}/out/test/suite/index"
            ],
            "outFiles": [
                "${workspaceFolder}/out/test/**/*.js",
                "${workspaceFolder}/dist/**/*.js"
            ],
            "sourceMaps": true,
            "preLaunchTask": "npm: test-compile",
            "env": {
                "DISABLE_COVERAGE": "true"
            }
        },
        {
            "name": "Debug Test Runner (Node CLI)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/out/test/runTest.js",
            "outFiles": [
                "${workspaceFolder}/out/test/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "preLaunchTask": "npm: test-compile"
        },
        {
            "name": "Sync docs from m68k-instructions-documentation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build/syncDocs.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}