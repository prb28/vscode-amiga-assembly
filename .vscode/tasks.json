// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: webpack",
            "type": "npm",
            "script": "webpack",
            "problemMatcher": "$ts-loader",
            "presentation": {
                "reveal": "silent"
            },
            "group": "build"
        },
        {
            "label": "npm: test-compile",
            "type": "npm",
            "script": "test-compile",
            "problemMatcher": "$tsc",
            "presentation": {
                "reveal": "silent"
            },
            "group": "build"
        },
        {
            "label": "npm: webpack-dev",
            "type": "npm",
            "script": "webpack-dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^(.*)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*(compiling|building|assets by path).*$",
                    "endsPattern": "^.*compiled successfully.*$"
                }
            },
            "presentation": {
                "reveal": "silent"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}